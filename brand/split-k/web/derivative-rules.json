{
  "version": 2,
  "authority": "Implements Mike\u2019s October 15 request to align favicon scale and corners and use the current Surfaces sharing-card pattern.",
  "palette": {
    "ink": "#0B0D0E",
    "ivory": "#F7F6F2",
    "nickel": "#8B9096"
  },
  "browserIcon": {
    "canvas": 64,
    "cornerRadius": 8,
    "visibleMarkHeight": 48,
    "center": [
      32,
      32
    ],
    "fallbackTheme": "light"
  },
  "regularAppIcon": {
    "canvas": 64,
    "cornerRadius": 0,
    "visibleMarkHeight": 48,
    "theme": "light"
  },
  "maskableIcon": {
    "canvas": 64,
    "cornerRadius": 0,
    "visibleMarkHeight": 36,
    "safeZoneRadiusRatio": 0.4,
    "theme": "light"
  },
  "socialCard": {
    "width": 1200,
    "height": 630,
    "background": "#0B0D0E",
    "source": "lockups/horizontal-reversed.svg",
    "maximumScale": 2.8,
    "maximumLockupWidth": 960,
    "taglineInArtwork": false
  },
  "iconRaster": {
    "renderer": "ImageMagick",
    "density": 384,
    "resize": "target dimensions with !",
    "stripMetadata": true,
    "colorspace": "sRGB",
    "format": "PNG32",
    "command": "magick -background none -density 384 source.svg -resize WIDTHxHEIGHT! -strip -colorspace sRGB PNG32:output.png"
  }
}
