KANBAN_CARDS_API_TOKEN=
KANBAN_CARDS_DATABASE_URL=
KANBAN_CARDS_OWNER_LABEL=Owner
KANBAN_CARDS_SESSION_TTL_SECONDS=604800
KANBAN_CARDS_ROOT_HOST=kanban.cards
# Optional bounded pre-promotion host family. Set both values only during the cutover.
# Exact release values: candidate.release.kanban.cards and {"mike":"mike.candidate.release.kanban.cards"}.
KANBAN_CARDS_CANDIDATE_ROOT_HOST=
# JSON object containing exactly the legacy Workspace slug and its one exact candidate tenant host.
KANBAN_CARDS_CANDIDATE_TENANT_HOSTS=
KANBAN_CARDS_API_WORKSPACE_ID=default
# Exact stable Clerk user ID. Never use an email address here.
KANBAN_CARDS_LEGACY_CLERK_USER_ID=
KANBAN_CARDS_LEGACY_WORKSPACE_SLUG=
KANBAN_CARDS_LEGACY_WORKSPACE_NAME=
# Comma-separated exact Clerk user IDs; production requires the legacy ID above to be included.
KANBAN_CARDS_ALLOWED_CLERK_USER_IDS=
# Use pk_test_ locally. Vercel production requires the Marketplace-synced pk_live_ key.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Compatibility alias only. If both names are set, their values must match.
# CLERK_PUBLISHABLE_KEY=
# Use sk_test_ locally. Vercel production requires the Marketplace-synced sk_live_ key.
CLERK_SECRET_KEY=
# At least 32 bytes; required by Clerk when middleware keys are selected per exact root host.
CLERK_ENCRYPTION_KEY=
# Exact dedicated auth-only application host. Clerk's production FAPI DNS/custom domain is configured separately.
KANBAN_CARDS_AUTH_HOST=auth.kanban.cards
SESSION_SECRET=
