# Production uses Postgres; leave empty for isolated local JSON storage.
KANBAN_CARDS_DATABASE_URL=
# At least 32 random bytes. Keep stable across server instances.
SESSION_SECRET=
# Production values. For local passkeys use board.localhost:4317 and auth.board.localhost:4317.
KANBAN_CARDS_ROOT_HOST=kanban.cards
KANBAN_CARDS_AUTH_HOST=auth.kanban.cards
# Optional one-hour bootstrap for the exact existing internal owner ID.
# Generate together with npm run auth:setup; remove after first-passkey enrollment.
KANBAN_CARDS_SETUP_OWNER_ID=
KANBAN_CARDS_SETUP_TOKEN_HASH=
KANBAN_CARDS_SETUP_EXPIRES_AT=
# Optional isolated local persistence paths. Keep them outside iCloud folders.
KANBAN_CARDS_DATA_PATH=
KANBAN_CARDS_ACCESS_DATA_PATH=
